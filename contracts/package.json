{
  "name": "contracts-tests",
  "version": "1.0.0",
  "description": "Stacks Network smart contract test suite using Clarinet SDK and Vitest.",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "vitest run",
    "test:report": "vitest run -- --coverage --costs",
    "test:watch": "chokidar \"tests/**/*.ts\" \"contracts/**/*.clar\" -c \"npm run test:report\"",
    "test:nft": "vitest run -- --reporter=verbose tests/nft-contract.test.ts",
    "test:token": "vitest run -- --reporter=verbose tests/token-contract.test.ts",
    "test:bridge": "vitest run -- --reporter=verbose tests/sip-009-bridge.test.ts",
    "test:multi-bridge": "vitest run -- --reporter=verbose tests/multi-token-bridge-*.test.ts",
    "deploy": "tsx scripts/deploy.ts",
    "deploy-multi-token": "tsx scripts/deploy-multi-token.ts",
    "deploy-wallet": "tsx scripts/deploy-wallet.ts",
    "check-account": "tsx scripts/check-account.ts",
    "check-pending": "tsx scripts/check-pending-transactions.ts",
    "cancel-stuck-txs": "tsx scripts/cancel-stuck-transactions.ts",
    "simple-mint": "tsx scripts/simple-mint.ts"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@stacks/clarinet-sdk": "^3.9.0",
    "@stacks/transactions": "^7.3.0",
    "@types/node": "^24.4.0",
    "chokidar-cli": "^3.0.0",
    "dotenv": "^17.2.3",
    "fs": "^0.0.1-security",
    "path": "^0.12.7",
    "vitest": "^4.0.7",
    "vitest-environment-clarinet": "^3.0.0"
  },
  "devDependencies": {
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0"
  }
}
